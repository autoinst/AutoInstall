[
        {
            "file": "/server.properties",
            "name": "服务端基础配置",
            "notice": "MC服务端基础配置，重启生效",
            "exps": [
                {
                    "type": "string",
                    "name": "服务器名称",
                    "notice": "修改服务器的显示名称",
                    "exp": "motd=(.+)"
                },
                {
                    "type": "number",
                    "name": "最大玩家数",
                    "exp": "max-players=([0-9]+)"
                },
                {
                    "type": "select",
                    "name": "游戏难度",
                    "exp": "difficulty=(peaceful|easy|normal|hard)",
                    "options": [
                        {
                            "label": "和平",
                            "value": "peaceful"
                        },
                        {
                            "label": "简单",
                            "value": "easy"
                        },
                        {
                            "label": "一般",
                            "value": "normal"
                        },
                        {
                            "label": "困难",
                            "value": "hard"
                        }
                    ]
                },
                {
                    "type": "number",
                    "name": "视野范围",
                    "notice": "玩家最大可看到的区块距离,建议4-12，较高的值会显著降低服务器性能",
                    "exp": "view-distance=([0-9]+)"
                },
                {
                    "type": "number",
                    "name": "模拟距离",
                    "notice": "当玩家远离区块的距离超过设定值后，该区块会停止加载。生物、植物停止生长；红石系统停止运行，且实体将不渲染，方块停止更新渲染。建议4-8。较高的值会显著降低服务器性能",
                    "exp": "simulation-distance=([0-9]+)"
                },
                {
                    "type": "select",
                    "name": "游戏模式",
                    "notice": "选择玩家的游戏模式",
                    "exp": "gamemode=(survival|creative|adventure)",
                    "options": [
                        {
                            "label": "生存",
                            "value": "survival"
                        },
                        {
                            "label": "创造",
                            "value": "creative"
                        },
                        {
                            "label": "冒险",
                            "value": "adventure"
                        }
                    ]
                },
                {
                    "type": "boolean",
                    "name": "启用命令方块",
                    "exp": "enable-command-block=(true|false)",
                    "rule": [
                        "true",
                        "false"
                    ]
                },
                {
                    "type": "boolean",
                    "name": "允许飞行",
                    "notice": "此处飞行指的是漂浮在空中，鞘翅移动，漂浮效果不算在内，基本是个摆设。如果网卡，或者有命令方块等，可能会造成服务器误判并踢出。",
                    "exp": "allow-flight=(true|false)",
                    "rule": [
                        "true",
                        "false"
                    ]
                },
                {
                    "type": "boolean",
                    "name": "启用下界",
                    "notice": "如果你不想要地狱这个维度可以把它关掉，会导致地狱维度不生成，且无法进入。",
                    "exp": "allow-nether=(true|false)",
                    "rule": [
                        "true",
                        "false"
                    ]
                },
                {
                    "type": "boolean",
                    "name": "PVP模式",
                    "notice": "允许玩家间互相攻击",
                    "exp": "pvp=(true|false)",
                    "rule": [
                        "true",
                        "false"
                    ]
                },
                {
                    "type": "boolean",
                    "name": "正版验证",
                    "notice": "在玩家登录时进行正版校验，只有认证用户才可登录",
                    "exp": "online-mode=(true|false)",
                    "rule": [
                        "true",
                        "false"
                    ]
                },
                {
                    "type": "boolean",
                    "name": "白名单",
                    "notice": "开启后仅白名单用户可加入服务器，必须<b>开启正版验证</b>后白名单才可使用。",
                    "exp": "white-list=(true|false)",
                    "rule": [
                        "true",
                        "false"
                    ]
                },
                {
                    "type": "number",
                    "name": "最大建筑高度",
                    "notice": "1.17版本及以上可调整至大于256",
                    "exp": "max-build-height=([0-9]+)"
                },
                {
                    "type": "number",
                    "name": "玩家挂机踢出",
                    "notice": "玩家挂机多久将会被踢出服务器，设置为0不进行判断，单位分钟",
                    "exp": "player-idle-timeout=([0-9]+)"
                },
                {
                    "type": "boolean",
                    "name": "强制游戏模式",
                    "notice": "无视之前玩家保存的游戏模式，在新加入时一律替换",
                    "exp": "force-gamemode=(true|false)",
                    "rule": [
                        "true",
                        "false"
                    ]
                },
                {
                    "type": "boolean",
                    "name": "硬核模式",
                    "notice": "当玩家死亡后，将无法复活，并且游戏难度将被锁定至困难",
                    "exp": "hardcore=(true|false)",
                    "rule": [
                        "true",
                        "false"
                    ]
                },
                {
                    "type": "number",
                    "name": "出生点保护范围",
                    "notice": "出生点周围的指定区块内无法被破坏",
                    "exp": "spawn-protection=([0-9]+)"
                },
                {
                    "type": "string",
                    "name": "地图名称",
                    "notice": "修改该值将会生成新的地图，在文件管理根目录下",
                    "exp": "level-name=(.+)"
                },
                {
                    "type": "number",
                    "name": "地图种子",
                    "exp": "level-seed=([-0-9]*)"
                },
                {
                    "type": "select",
                    "name": "地图类型",
                    "exp": "level-type=(DEFAULT|FLAT)",
                    "notice": "更改此设置生效需要重新生成地图",
                    "options": [
                        {
                            "label": "正常",
                            "value": "default"
                        },
                        {
                            "label": "超平坦",
                            "value": "flat"
                        }
             ]
            }
        ]
    },
    {
        "file": "/inst.json",
        "name": "安装器配置",
        "notice": "inst.json 可选；整合包目标来自包内声明，忽略此处的版本、加载器、加载器版本和下载源，只读取执行选项。整合包安装不改写此文件。覆盖包目标请用 --modpack 加目标参数；--no-modpack 强制普通安装。多个包请用 --modpack 指定。",
        "exps": [
            {
                "type": "string",
                "name": "我的世界版本",
                "notice": "仅普通安装使用；可被 --mc-version 覆盖。latest 保留加载器各自的选择规则，原版会选择最新快照。",
                "exp": "\"version\": \"(.*)\""
            },
            {
                "type": "select",
                "name": "加载器",
                "notice": "仅普通安装使用；默认为原版。快照不能安装 (Neo)Forge；切换非原版加载器时也需明确加载器版本。",
                "exp": "\"loader\": \"(forge|fabric|neoforge|vanilla)\"",
                "options": [
                    {
                        "label": "Forge",
                        "value": "forge"
                    },
                    {
                        "label": "Fabric",
                        "value": "fabric"
                    },
                    {
                        "label": "NeoForge",
                        "value": "neoforge"
                    },
                    {
                        "label": "原版",
                        "value": "vanilla"
                    }
                ]
            },
            {
                "type": "string",
                "name": "加载器版本",
                "notice": "仅普通安装使用；非原版加载器必须指定具体版本或 latest，原版不使用该字段。",
                "exp": "\"loaderVersion\": \"(.*)\""
            },
            {
                "type": "select",
                "name": "文件下载源",
                "notice": "默认 official；none 兼容 official。整合包模式忽略此项，请用 --download 选择源。镜像可能缺少刚发布的版本。",
                "exp": "\"download\":\\s*\"(official|bmclapi|none)\"",
                "options": [
                    {
                        "label": "BMCLAPI",
                        "value": "bmclapi"
                    },
                    {
                        "label": "官方源（默认）",
                        "value": "official"
                    },
                    {
                        "label": "官方源（旧 none 配置）",
                        "value": "none"
                    }
                ]
            },
            {
                "type": "string",
                "name": "最大并发下载数",
                "notice": "默认 4，必须为正整数；整合包模式也生效，可被 --maxconnections 覆盖。",
                "exp": "\"maxconnections\":\\s*([0-9]+)"
            },
            {
                "type": "string",
                "name": "每源最大尝试次数",
                "notice": "默认 3，必须为正整数；包含首次尝试。",
                "exp": "\"maxretries\":\\s*([0-9]+)"
            },
            {
                "type": "string",
                "name": "自定义 JVM 参数",
                "notice": "默认空；整合包模式也生效。命令行 --argsment= 可显式清空配置值。",
                "exp": "\"argsment\":\\s*\"(.*)\""
            },
            {
                "type": "boolean",
                "name": "跟随整合包模组文件名",
                "notice": "默认 true；关闭时保留目录，按成功下载候选 URL 命名模组；非模组资源和 overrides 不改名。CLI 关闭语法：--follow-modpack-filenames=false。",
                "exp": "\"followModpackFilenames\":\\s*(true|false)",
                "rule": ["true", "false"]
            },
            {
                "type": "boolean",
                "name": "启用模组分类器",
                "notice": "默认 true；关闭时跳过额外客户端模组检测及移动，但仍排除 Modrinth 明确不支持服务端的文件。不保证模组兼容。CLI 关闭语法：--mod-classifier=false。",
                "exp": "\"enableModClassifier\":\\s*(true|false)",
                "rule": ["true", "false"]
            }
        ]
    }
]